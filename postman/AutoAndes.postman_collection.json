  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const nombre = pm.info.requestName;",
          "const elegirServicio = nombre.startsWith('201 Crear servicio');",
          "const elegirVehiculo = nombre.startsWith('201 Crear vehículo');",
          "if (elegirServicio || elegirVehiculo) {",
          "  const recurso = elegirServicio ? '/servicios' : '/vehiculos';",
          "  pm.sendRequest({url: pm.variables.get('baseUrl') + recurso, method: 'GET', header: {Authorization: 'Bearer ' + pm.collectionVariables.get('tokenAdmin')}}, (err, res) => {",
          "    if (err) throw err;",
          "    pm.expect(res.code).to.equal(200);",
          "    const rows = res.json();",
          "    const usados = new Set(rows.map(x => elegirServicio ? x.codigo : x.placa));",
          "    const opciones = Array.from({length: 800}, (_, i) => elegirServicio ? 'SRV-' + (100 + i) : 'QPM-' + (100 + i));",
          "    const libre = opciones.find(x => !usados.has(x));",
          "    if (!libre) throw new Error('Sin código o placa de prueba libre');",
          "    pm.collectionVariables.set(elegirServicio ? 'codigoLibre' : 'placaLibre', libre);",
          "  });",
          "}",
          "if (nombre.includes('Tercer detalle inactivo')) {",
          "  pm.sendRequest({url: pm.variables.get('baseUrl') + '/ordenes', method: 'GET', header: {Authorization: 'Bearer ' + pm.collectionVariables.get('tokenAdmin')}}, (err, res) => { if (err) throw err; pm.collectionVariables.set('ordenesAntes', res.json().length); });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "  const error = pm.response.json();",
          "  pm.test('Error con formato común', () => { ['timestamp','status','error','mensaje','ruta'].forEach(k => pm.expect(error).to.have.property(k)); });",
          "  if (pm.response.code !== 400) pm.test('Sin campos fuera de validación', () => pm.expect(error).not.to.have.property('campos'));",
          "}",
          "if (pm.info.requestName.includes('Tercer detalle inactivo')) {",
          "  pm.sendRequest({url: pm.variables.get('baseUrl') + '/ordenes', method: 'GET', header: {Authorization: 'Bearer ' + pm.collectionVariables.get('tokenAdmin')}}, (err, res) => { if (err) throw err; pm.test('Rollback: no dejó cabecera', () => pm.expect(res.json().length).to.equal(Number(pm.collectionVariables.get('ordenesAntes')))); });",
          "}"
        ]
      }
    }
  ]
